//============================================================
//
//  rea-crt-arcade-flat.json: Rad Mobile launcher CRT filter, Arcade, flat.
//
//  Bloom extract -> Gaussian blur (H, V) on a guest-sized target
//  -> composite (barrel warp, luminance-dependent scanline beam,
//  3-pixel phosphor mask, glow, vignette).
//
//  After Timothy Lottes' public-domain CRT shader; parameters after
//  Wanszai's Scud Race PC port. Shaders: bgfx/src/rea-crt in the
//  launcher repository.
//
//============================================================
{
	"name": "REA CRT (Arcade, flat)",
	"author": "Rad Mobile launcher",
	"targets": [
		{ "name": "bloom", "mode": "guest" },
		{ "name": "blurh", "mode": "guest" },
		{ "name": "glow",  "mode": "guest" }
	],
	"passes": [
		{
			"effect": "rea-crt/bloom",
			"name": "Bloom extract",
			"uniforms": [
				{ "uniform": "u_bloom", "value": [ 0.40, 0.0, 0.0, 0.0 ] }
			],
			"input": [
				{ "sampler": "s_tex", "target": "screen" }
			],
			"output": "bloom"
		},
		{
			"effect": "rea-crt/blur",
			"name": "Glow blur H",
			"uniforms": [
				{ "uniform": "u_blur_dir", "value": [ 1.0, 0.0, 0.0, 0.0 ] }
			],
			"input": [
				{ "sampler": "s_tex", "target": "bloom" }
			],
			"output": "blurh"
		},
		{
			"effect": "rea-crt/blur",
			"name": "Glow blur V",
			"uniforms": [
				{ "uniform": "u_blur_dir", "value": [ 0.0, 1.0, 0.0, 0.0 ] }
			],
			"input": [
				{ "sampler": "s_tex", "target": "blurh" }
			],
			"output": "glow"
		},
		{
			"effect": "rea-crt/composite",
			"name": "CRT composite",
			"uniforms": [
				// scanline strength, beam width min, beam width max, virtual lines (0 = game screen height)
				{ "uniform": "u_scan", "value": [ 0.50, 0.80, 1.40, 0.0 ] },
				// mask strength, mask type (0 aperture grille, 1 shadow mask), glow strength, brightness
				{ "uniform": "u_mask", "value": [ 0.45, 1.0, 0.35, 1.0 ] },
				// curvature, vignette
				{ "uniform": "u_geom", "value": [ 0.0, 0.0, 0.0, 0.0 ] }
			],
			"input": [
				{ "sampler": "s_screen", "target": "screen" },
				{ "sampler": "s_glow",   "target": "glow" }
			],
			"output": "output"
		}
	]
}
