 	output_finder<> m_output_right_winner_lamp;
 	output_finder<> m_output_wiper_lamp;
+
+	// rea-rad-mobile: Rad Mobile telemetry for the launcher's synthetic force
+	// feedback, read from work RAM at every vblank (docs/RAM_MAP.md)
+	bool m_rea_telemetry = false;
+	output_finder<> m_rea_speed;
+	output_finder<> m_rea_lateral;
+	output_finder<> m_rea_playing;
+	output_finder<> m_rea_heading;
+	void rea_update_telemetry();
+
+	// rea-rad-mobile: Rad Mobile drops any steering sample more than 0x40
+	// away from the last one it accepted and keeps the old value (code at
+	// 0x70333; MAME Testers 08052). A stick released from full lock jumps
+	// back to centre in one frame, so the game keeps steering. The steering
+	// sent to the ADC moves toward the control at most this much per sample,
+	// as fast as a real wheel can turn.
+	static constexpr int REA_STEER_STEP = 0x30;
+	bool m_rea_steer_limit = false;
+	uint8_t m_rea_steer = 0x80;
+	optional_ioport m_rea_analog1;
+	ioport_value rea_analog1_r();
 };
 
