diff --git a/src/osd/modules/lib/reabridge.h b/src/osd/modules/lib/reabridge.h
new file mode 100644
index 00000000..2984d21c
--- /dev/null
+++ b/src/osd/modules/lib/reabridge.h
@@ -0,0 +1,182 @@
+// license:BSD-3-Clause
+// copyright-holders:rea-rad-mobile contributors
+//============================================================
+//
+//  reabridge.h - shared-memory link between MAME and the
+//  rea-rad-mobile launcher.
+//
+//  The launcher owns the steering wheel, pedals and force
+//  feedback. It writes the cabinet's controls into a small
+//  memory-mapped file and MAME reads them as one joystick
+//  (-joystickprovider reabridge). MAME writes its output
+//  notifications (lamps, telemetry set from Lua) back into
+//  the same file (-output reabridge).
+//
+//  The file path comes from the REA_BRIDGE environment
+//  variable. The launcher creates and initialises the file
+//  before starting MAME; MAME never creates it.
+//
+//  The layout is fixed, little-endian and mirrored by the
+//  launcher (crates/radmobile-core/src/bridge.rs). Change
+//  both together and bump VERSION.
+//
+//============================================================
+#ifndef MAME_OSD_LIB_REABRIDGE_H
+#define MAME_OSD_LIB_REABRIDGE_H
+
+#pragma once
+
+#include <atomic>
+#include <cstddef>
+#include <cstdint>
+#include <cstdlib>
+#include <cstring>
+
+#if defined(_WIN32)
+#ifndef WIN32_LEAN_AND_MEAN
+#define WIN32_LEAN_AND_MEAN
+#endif
+#include <windows.h>
+#else
+#include <fcntl.h>
+#include <sys/mman.h>
+#include <sys/stat.h>
+#include <unistd.h>
+#endif
+
+namespace osd::reabridge {
+
+inline constexpr char MAGIC[8] = { 'R', 'E', 'A', 'B', 'R', 'D', 'G', '1' };
+inline constexpr std::uint32_t VERSION = 1;
+inline constexpr std::size_t FILE_SIZE = 4096;
+inline constexpr unsigned AXIS_COUNT = 8;
+inline constexpr unsigned BUTTON_COUNT = 64;
+inline constexpr unsigned OUTPUT_SLOTS = 64;
+inline constexpr unsigned OUTPUT_NAME_LEN = 48;
+
+struct output_slot
+{
+	char name[OUTPUT_NAME_LEN];       // NUL-terminated, written once before publication
+	std::int32_t value;
+	std::uint32_t seq;                // bumped after every value write
+};
+
+struct layout
+{
+	char magic[8];                    // 0
+	std::uint32_t version;            // 8
+	std::uint32_t size;               // 12
+	std::uint32_t launcher_seq;       // 16 launcher heartbeat (bumped on every input write)
+	std::uint32_t mame_seq;           // 20 MAME heartbeat (bumped on every poll)
+	std::int32_t axes[AXIS_COUNT];    // 24 -65536..65536, MAME's absolute range
+	std::uint32_t buttons[BUTTON_COUNT / 32]; // 56 bit n = button n+1
+	std::uint32_t flags;              // 64 reserved
+	std::uint32_t output_count;       // 68 published output slots
+	std::uint8_t reserved[56];        // 72
+	output_slot outputs[OUTPUT_SLOTS];// 128
+};
+
+static_assert(offsetof(layout, axes) == 24, "bridge layout");
+static_assert(offsetof(layout, buttons) == 56, "bridge layout");
+static_assert(offsetof(layout, output_count) == 68, "bridge layout");
+static_assert(offsetof(layout, outputs) == 128, "bridge layout");
+static_assert(sizeof(output_slot) == 56, "bridge layout");
+static_assert(sizeof(layout) <= FILE_SIZE, "bridge layout");
+
+// 32-bit aligned loads and stores are atomic on every target we build for;
+// atomic_ref only adds the ordering the reader on the other side relies on.
+inline std::uint32_t load(std::uint32_t const &v) { return std::atomic_ref<std::uint32_t const>(v).load(std::memory_order_acquire); }
+inline std::int32_t load(std::int32_t const &v) { return std::atomic_ref<std::int32_t const>(v).load(std::memory_order_acquire); }
+inline void store(std::uint32_t &v, std::uint32_t x) { std::atomic_ref<std::uint32_t>(v).store(x, std::memory_order_release); }
+inline void store(std::int32_t &v, std::int32_t x) { std::atomic_ref<std::int32_t>(v).store(x, std::memory_order_release); }
+
+// A read-write mapping of the bridge file. Empty when REA_BRIDGE is unset
+// or the file is not a valid bridge.
+class mapping
+{
+public:
+	mapping() = default;
+	mapping(mapping const &) = delete;
+	mapping &operator=(mapping const &) = delete;
+	~mapping() { close(); }
+
+	bool open()
+	{
+		char const *const path = std::getenv("REA_BRIDGE");
+		if (!path || !*path)
+			return false;
+#if defined(_WIN32)
+		int const wlen = MultiByteToWideChar(CP_UTF8, 0, path, -1, nullptr, 0);
+		if (wlen <= 0)
+			return false;
+		auto *const wpath = new wchar_t[wlen];
+		MultiByteToWideChar(CP_UTF8, 0, path, -1, wpath, wlen);
+		m_file = CreateFileW(wpath, GENERIC_READ | GENERIC_WRITE, FILE_SHARE_READ | FILE_SHARE_WRITE, nullptr, OPEN_EXISTING, FILE_ATTRIBUTE_NORMAL, nullptr);
+		delete[] wpath;
+		if (m_file == INVALID_HANDLE_VALUE)
+			return false;
+		m_map = CreateFileMappingW(m_file, nullptr, PAGE_READWRITE, 0, DWORD(FILE_SIZE), nullptr);
+		if (!m_map)
+		{
+			close();
+			return false;
+		}
+		m_view = MapViewOfFile(m_map, FILE_MAP_ALL_ACCESS, 0, 0, FILE_SIZE);
+#else
+		m_fd = ::open(path, O_RDWR);
+		if (m_fd < 0)
+			return false;
+		struct stat st;
+		if (fstat(m_fd, &st) != 0 || std::size_t(st.st_size) < FILE_SIZE)
+		{
+			close();
+			return false;
+		}
+		void *const view = mmap(nullptr, FILE_SIZE, PROT_READ | PROT_WRITE, MAP_SHARED, m_fd, 0);
+		m_view = (view == MAP_FAILED) ? nullptr : view;
+#endif
+		if (!m_view || std::memcmp(get()->magic, MAGIC, sizeof(MAGIC)) != 0 || get()->version != VERSION)
+		{
+			close();
+			return false;
+		}
+		return true;
+	}
+
+	void close()
+	{
+#if defined(_WIN32)
+		if (m_view)
+			UnmapViewOfFile(m_view);
+		if (m_map)
+			CloseHandle(m_map);
+		if (m_file != INVALID_HANDLE_VALUE)
+			CloseHandle(m_file);
+		m_map = nullptr;
+		m_file = INVALID_HANDLE_VALUE;
+#else
+		if (m_view)
+			munmap(m_view, FILE_SIZE);
+		if (m_fd >= 0)
+			::close(m_fd);
+		m_fd = -1;
+#endif
+		m_view = nullptr;
+	}
+
+	layout *get() const { return static_cast<layout *>(m_view); }
+	explicit operator bool() const { return m_view != nullptr; }
+
+private:
+	void *m_view = nullptr;
+#if defined(_WIN32)
+	HANDLE m_file = INVALID_HANDLE_VALUE;
+	HANDLE m_map = nullptr;
+#else
+	int m_fd = -1;
+#endif
+};
+
+} // namespace osd::reabridge
+
+#endif // MAME_OSD_LIB_REABRIDGE_H
