+	m_rea_telemetry = true; // rea-rad-mobile
+	m_rea_steer_limit = true;
+	save_item(NAME(m_rea_steer));
+}
+
+// rea-rad-mobile: steering for the ADC, rate-limited for Rad Mobile
+ioport_value segas32_state::rea_analog1_r()
+{
+	int const target = m_rea_analog1.read_safe(0xff) & 0xff;
+	if (!m_rea_steer_limit)
+		return target;
+	int const step = std::clamp(target - int(m_rea_steer), -REA_STEER_STEP, REA_STEER_STEP);
+	m_rea_steer = uint8_t(m_rea_steer + step);
+	return m_rea_steer;
+}
+
+// rea-rad-mobile: work RAM is little-endian 16-bit words from 0x200000
+void segas32_state::rea_update_telemetry()
+{
+	uint16_t const *const ram = &m_system32_workram[0];
+	m_rea_speed = ram[0x1f44 / 2];                       // 0..~430
+	m_rea_lateral = int16_t(ram[0x1f46 / 2]);            // negative is left, barriers near +-560
+	m_rea_heading = int16_t(ram[0x1f30 / 2]);            // angle to the road, positive points left
+	m_rea_playing = (ram[0x18ae / 2] >> 8) != 0 ? 1 : 0; // byte 0x2018af
 }
 
 
