new file mode 100644
index 00000000..1ed72d63
--- /dev/null
+++ b/src/osd/modules/output/reabridge.cpp
@@ -0,0 +1,94 @@
+// license:BSD-3-Clause
+// copyright-holders:rea-rad-mobile contributors
+/***************************************************************************
+
+    reabridge.cpp
+
+    Output provider that publishes MAME's output notifications
+    (lamps, and the telemetry a Lua plugin sets) into the
+    rea-rad-mobile bridge file (see modules/lib/reabridge.h).
+    The launcher reads them to drive force feedback.
+
+***************************************************************************/
+
+#include "output_module.h"
+
+#include "modules/lib/reabridge.h"
+#include "modules/osdmodule.h"
+#include "osdcore.h"
+
+#include <cstring>
+#include <string_view>
+
+namespace osd {
+
+namespace {
+
+class output_reabridge : public osd_module, public output_module
+{
+public:
+	output_reabridge() : osd_module(OSD_OUTPUT_PROVIDER, "reabridge")
+	{
+	}
+	virtual ~output_reabridge() { }
+
+	virtual int init(osd_interface &osd, const osd_options &options) override
+	{
+		if (!m_bridge.open())
+			osd_printf_warning("reabridge: REA_BRIDGE is unset or not a bridge file; outputs dropped\n");
+		return 0;
+	}
+
+	virtual void exit() override { m_bridge.close(); }
+
+	// output_module
+	virtual void notify(const output_item &item, std::int32_t seconds, std::int64_t attoseconds) override
+	{
+		publish(item.qualified_name(), item.value());
+	}
+	virtual void pause() override { publish("pause", 1); }
+	virtual void resume() override { publish("pause", 0); }
+	virtual void update() override { }
+
+private:
+	void publish(std::string_view name, std::int32_t value)
+	{
+		reabridge::layout *const shm = m_bridge.get();
+		if (!shm || name.empty() || name.size() >= reabridge::OUTPUT_NAME_LEN)
+			return;
+
+		std::uint32_t const count = reabridge::load(shm->output_count);
+		for (std::uint32_t i = 0; i < count && i < reabridge::OUTPUT_SLOTS; i++)
+		{
+			reabridge::output_slot &slot = shm->outputs[i];
+			if (name == std::string_view(slot.name))
+			{
+				write(slot, value);
+				return;
+			}
+		}
+		if (count >= reabridge::OUTPUT_SLOTS)
+			return;
+
+		// fill the new slot completely before the count makes it visible
+		reabridge::output_slot &slot = shm->outputs[count];
+		std::memset(slot.name, 0, sizeof(slot.name));
+		std::memcpy(slot.name, name.data(), name.size());
+		write(slot, value);
+		reabridge::store(shm->output_count, count + 1);
+	}
+
+	static void write(reabridge::output_slot &slot, std::int32_t value)
+	{
+		reabridge::store(slot.value, value);
+		reabridge::store(slot.seq, reabridge::load(slot.seq) + 1);
+	}
+
+	reabridge::mapping m_bridge;
+};
+
+} // anonymous namespace
+
+} // namespace osd
+
+MODULE_DEFINITION(OUTPUT_REABRIDGE, osd::output_reabridge)
