+// license:BSD-3-Clause
+// copyright-holders:rea-rad-mobile contributors
+//============================================================
+//
+//  input_reabridge.cpp - joystick provider fed by the
+//  rea-rad-mobile launcher through shared memory
+//  (see modules/lib/reabridge.h).
+//
+//  It exposes one joystick, "REA Bridge", with eight
+//  absolute axes and 32 buttons. The launcher has already
+//  applied steering lock, dead zones, curves and pedal
+//  calibration, so values pass through unchanged.
+//
+//============================================================
+
+#include "input_module.h"
+#include "modules/osdmodule.h"
+
+#include "input_common.h"
+
+#include "modules/lib/osdobj_common.h"
+#include "modules/lib/reabridge.h"
+#include "osdcore.h"
+
+#include <algorithm>
+#include <array>
+
+namespace osd {
+
+namespace {
+
+class reabridge_joystick_device : public device_info
+{
+public:
+	reabridge_joystick_device(std::string &&name, std::string &&id, input_module &module, reabridge::mapping &bridge) :
+		device_info(std::move(name), std::move(id), module),
+		m_bridge(bridge)
+	{
+		reset();
+	}
+
+	virtual void poll(bool relative_reset) override
+	{
+		reabridge::layout *const shm = m_bridge.get();
+		if (!shm)
+			return;
+
+		for (unsigned i = 0; i < reabridge::AXIS_COUNT; i++)
+		{
+			std::int32_t const v = reabridge::load(shm->axes[i]);
+			m_axes[i] = std::clamp(v, input_device::ABSOLUTE_MIN, input_device::ABSOLUTE_MAX);
+		}
+		std::uint32_t const pressed = reabridge::load(shm->buttons[0]);
+		for (unsigned i = 0; i < BUTTONS; i++)
+			m_buttons[i] = ((pressed >> i) & 1U) ? 0x80 : 0x00;
+
+		reabridge::store(shm->mame_seq, reabridge::load(shm->mame_seq) + 1);
+	}
+
+	virtual void reset() override
+	{
+		m_axes.fill(0);
+		// pedals rest at the minimum of their range
+		m_axes[1] = input_device::ABSOLUTE_MIN;
+		m_axes[2] = input_device::ABSOLUTE_MIN;
+		m_buttons.fill(0);
+	}
+
+	virtual void configure(input_device &device) override
+	{
+		for (unsigned i = 0; i < reabridge::AXIS_COUNT; i++)
+		{
+			device.add_item(
+					default_axis_name[i],
+					std::string_view(),
+					input_item_id(ITEM_ID_XAXIS + i),
+					generic_axis_get_state<std::int32_t>,
+					&m_axes[i]);
+		}
+		for (unsigned i = 0; i < BUTTONS; i++)
+		{
+			device.add_item(
+					default_button_name(i),
+					std::string_view(),
+					input_item_id(ITEM_ID_BUTTON1 + i),
+					generic_button_get_state<std::uint8_t>,
+					&m_buttons[i]);
+		}
+	}
+
+private:
+	// MAME joysticks stop at Button 32; the bridge's second word is spare
+	static inline constexpr unsigned BUTTONS = 32;
+
+	reabridge::mapping &m_bridge;
+	std::array<std::int32_t, reabridge::AXIS_COUNT> m_axes;
+	std::array<std::uint8_t, BUTTONS> m_buttons;
+};
+
+
+class reabridge_joystick_module : public input_module_impl<reabridge_joystick_device, osd_common_t>
+{
+public:
+	reabridge_joystick_module() :
+		input_module_impl<reabridge_joystick_device, osd_common_t>(OSD_JOYSTICKINPUT_PROVIDER, "reabridge")
+	{
+	}
+
+	virtual void input_init(running_machine &machine) override
+	{
+		input_module_impl<reabridge_joystick_device, osd_common_t>::input_init(machine);
+
+		if (!m_bridge.open())
+		{
+			osd_printf_warning("reabridge: REA_BRIDGE is unset or not a bridge file; no joystick\n");
+			return;
+		}
+		osd_printf_verbose("reabridge: joystick connected\n");
+		create_device<reabridge_joystick_device>(DEVICE_CLASS_JOYSTICK, "REA Bridge", "reabridge-0", m_bridge);
+	}
+
+	virtual void exit() override
+	{
+		input_module_impl<reabridge_joystick_device, osd_common_t>::exit();
+		m_bridge.close();
+	}
+
+protected:
+	// the launcher keeps feeding the controls while another window has focus
+	virtual bool should_poll_devices() override { return true; }
+
+private:
+	reabridge::mapping m_bridge;
+};
+
+} // anonymous namespace
+
+} // namespace osd
+
+MODULE_DEFINITION(JOYSTICKINPUT_REABRIDGE, osd::reabridge_joystick_module)
