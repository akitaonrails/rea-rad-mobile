 	std::unique_ptr<uint16_t[]> m_solid_ffff;
 	uint8_t m_sprite_render_count = 0;
 	uint8_t m_sprite_control_latched[8]{};
+
+	// rea-rad-mobile: true widescreen. The original 320-pixel picture is
+	// drawn m_wide_margin pixels in from the left of a wider screen and the
+	// tilemaps, sprites and clip windows fill the margins on both sides.
+	// Set from REA_S32_WIDE_MARGIN; 0 keeps the original picture.
+	int m_wide_margin = 0;
+	static constexpr int WIDE_MARGIN_MAX = 96;
+	int wide_margin() const { return BIT(m_videoram[0x1ff00/2], 15) ? 0 : m_wide_margin; }
+	int wide_clip_min_x(int x) const { return (x <= 0) ? x : x + wide_margin(); }
+	int wide_clip_max_x(int x, int screen_max) const { return (x >= screen_max - 2 * wide_margin()) ? screen_max : x + wide_margin(); }
 	uint8_t m_sprite_control[8]{};
